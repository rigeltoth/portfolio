{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build-css": "npx tailwindcss-cli@latest build -i ./src/styles.css -o ./dist/portfolio/styles.css",
    "build-ghp": "ng build --base-href https://rigeltoth.github.io/portfolio/",
    "deploy-ghp": "npx angular-cli-ghpages --dir=dist/portfolio/browser"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "aos": "^2.3.4",
    "lottie-web": "^5.13.0",
    "ngx-lottie": "^22.0.0",
    "rxjs": "~7.8.2",
    "swiper": "^14.4.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@types/aos": "^3.0.4",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^24.0.0",
    "angular-cli-ghpages": "^3.1.2",
    "autoprefixer": "^10.4.2",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.6",
    "postcss-import": "^14.0.2",
    "tailwindcss": "^3.0.23",
    "typescript": "~6.0.0",
    "@angular/build": "^22.3.0"
  }
}
